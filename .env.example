# Runtime assignment
CUDA_VISIBLE_DEVICES=0
HF_HOME=.cache/huggingface

# Discovery Agent
MDPT_AGENT_COMMAND=
MDPT_AGENT_MODEL=
MDPT_AGENT_BASE_URL=
MDPT_AGENT_API_KEY=

# Data augmentation backend
MDPT_AUGMENTATION_MODEL=
MDPT_AUGMENTATION_BASE_URL=
MDPT_AUGMENTATION_API_KEY=
MDPT_AUGMENTATION_MAX_TOKENS=8192
MDPT_AUGMENTATION_TEMPERATURE=0.3
MDPT_AUGMENTATION_TIMEOUT_SECONDS=300

# Search proposal planner
MDPT_PLANNER_MODEL=
MDPT_PLANNER_BASE_URL=
MDPT_PLANNER_API_KEY=

# LLM judge used only by evaluation tasks such as HealthBench
MDPT_EVALUATION_API_KEY=
MDPT_EVALUATION_BASE_URL=
MDPT_HEALTHBENCH_JUDGE_MODEL=gpt-5.4-mini
MDPT_HEALTHBENCH_JUDGE_WORKERS=16
